# ============================================================
# OPENVPN ACCESS SERVER - USER CHECK & PASSWORD RESET
# User: Nikil Shetty
# ============================================================


# =========================
# 1. READ-ONLY COMMANDS
# =========================

# Check OpenVPN Access Server version
sudo /usr/local/openvpn_as/scripts/sacli version

# Check whether local authentication is enabled
sudo /usr/local/openvpn_as/scripts/sacli LocalAuthEnabled

# List all configured users
sudo /usr/local/openvpn_as/scripts/sacli UserPropGet

# Check Nikil Shetty account/profile information
sudo /usr/local/openvpn_as/scripts/sacli UserPropGet | grep -A 10 -B 2 "Nikil Shetty"

# List VPN client profiles/certificates
sudo /usr/local/openvpn_as/scripts/sacli ListClientsDetail

# Check Nikil's available profile serial numbers
sudo /usr/local/openvpn_as/scripts/sacli ListClientsDetail | grep -i -A 10 -B 5 "Nikil Shetty"

# Check whether physical .ovpn files exist
sudo find / -type f -name "*.ovpn" 2>/dev/null

# Check Access Server services/status
sudo /usr/local/openvpn_as/scripts/sacli status


# =========================
# 2. PROFILE CHECK
# =========================

# Example: retrieve Nikil's profile using serial 106
# WARNING: This outputs confidential certificate/private-key data.
# Do NOT paste the output into chat.
sudo /usr/local/openvpn_as/scripts/sacli --sn 106 getuserprofile


# =========================
# 3. CREATE .OVPN FILE
# =========================

# Generate Nikil's profile into a file
sudo /usr/local/openvpn_as/scripts/sacli --sn 106 getuserprofile > /tmp/nikil-106.ovpn

# Secure the generated profile
sudo chmod 600 /tmp/nikil-106.ovpn

# Verify only the file details, NOT its contents
ls -lh /tmp/nikil-106.ovpn


# =========================
# 4. CHANGE - RESET PASSWORD
# =========================

# Reset Nikil Shetty's local password
# Replace NEW_PASSWORD with the new password.
sudo /usr/local/openvpn_as/scripts/sacli --user "Nikil Shetty" --new_pass 'NEW_PASSWORD' SetLocalPassword

# Restart/reload Access Server configuration
sudo /usr/local/openvpn_as/scripts/sacli start


# =========================
# 5. VERIFY AFTER PASSWORD RESET
# =========================

# Verify Nikil account still exists
sudo /usr/local/openvpn_as/scripts/sacli UserPropGet | grep -A 10 -B 2 "Nikil Shetty"

# Check Access Server status
sudo /usr/local/openvpn_as/scripts/sacli status
