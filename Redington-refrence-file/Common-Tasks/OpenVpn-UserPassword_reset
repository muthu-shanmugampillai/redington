# ============================================================
# OPENVPN ACCESS SERVER - USER CHECK / PASSWORD RESET RUNBOOK
# ============================================================


# ============================================================
# 1. READ-ONLY CHECKS
# ============================================================

# Check OpenVPN Access Server version
sudo /usr/local/openvpn_as/scripts/sacli version

# Check whether Local Authentication is enabled
sudo /usr/local/openvpn_as/scripts/sacli LocalAuthEnabled

# List all users and their basic properties
sudo /usr/local/openvpn_as/scripts/sacli UserPropGet

# List all client VPN profiles/certificates
sudo /usr/local/openvpn_as/scripts/sacli ListClientsDetail

# Check whether any physical .ovpn files exist
sudo find / -type f -name "*.ovpn" 2>/dev/null

# Check Access Server status
sudo /usr/local/openvpn_as/scripts/sacli status


# ============================================================
# 2. CHECK A SPECIFIC USER
# ============================================================

# Replace USERNAME with the required username
sudo /usr/local/openvpn_as/scripts/sacli UserPropGet | grep -A 10 -B 2 "USERNAME"

# Find the user's VPN profile/certificate
sudo /usr/local/openvpn_as/scripts/sacli ListClientsDetail | grep -i -A 10 -B 5 "USERNAME"


# ============================================================
# 3. RETRIEVE A USER'S .OVPN PROFILE
# ============================================================

# Replace SERIAL_NUMBER with the user's profile serial number
# WARNING: This displays confidential certificate/private-key data.
sudo /usr/local/openvpn_as/scripts/sacli --sn SERIAL_NUMBER getuserprofile


# ============================================================
# 4. CREATE A .OVPN FILE
# ============================================================

# Generate the profile into a temporary file
sudo /usr/local/openvpn_as/scripts/sacli --sn SERIAL_NUMBER getuserprofile > /tmp/USERNAME.ovpn

# Secure the file
sudo chmod 600 /tmp/USERNAME.ovpn

# Verify only file details
ls -lh /tmp/USERNAME.ovpn


# ============================================================
# 5. RESET USER PASSWORD
# ============================================================

# Replace USERNAME and NEW_PASSWORD
sudo /usr/local/openvpn_as/scripts/sacli --user "USERNAME" --new_pass 'NEW_PASSWORD' SetLocalPassword

# Reload/start Access Server
sudo /usr/local/openvpn_as/scripts/sacli start


# ============================================================
# 6. POST-CHANGE VERIFICATION
# ============================================================

# Confirm user still exists
sudo /usr/local/openvpn_as/scripts/sacli UserPropGet

# Check Access Server status
sudo /usr/local/openvpn_as/scripts/sacli status

# Check the user's VPN profile again
sudo /usr/local/openvpn_as/scripts/sacli ListClientsDetail
